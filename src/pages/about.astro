---
import { getCollection } from 'astro:content';
import SiteLayout from '@layouts/SiteLayout.astro';
import Lightbox from '@components/story/Lightbox.astro';
import { compareStories, formatCoordinates, storyFrames } from '@scripts/utils/story-manifest';

const portraitBase = 'https://heist-studio.sfo3.cdn.digitaloceanspaces.com/photos/about-portrait';
const portraitLqip = 'data:image/webp;base64,UklGRooAAABXRUJQVlA4IH4AAAAwBQCdASoUAB4APzmGt1QvKKUjMBgMAeAnCUAYdYr+Fp2APb7irYm+cmTiXdOQ+EAcwAD+78d/MK1gVhexQksPU/TNAIU/Ob6QR82qumtFoBOXmmA2NkiAzOkq37OJrL002KoObJFcJDqO8OGkq4rmuVGUaNaEckpA1RFUAAA=';

const ksarBase = 'https://heist-studio.sfo3.cdn.digitaloceanspaces.com/photos/heist-ksar-essay-001-cnh_3628';
const ksarLqip = 'data:image/webp;base64,UklGRm4AAABXRUJQVlA4IGIAAADQAwCdASoUAA0APzmGulOvKKWisAgB4CcJZgCdABVMf5fTxeZtJAAA/Sg8oHK1A2k1PN6bRmq/0twRB0hsT7ynLd+uVaEXUfAdpaxNpMuQbcf6TMUZQH8Q6jGWfJQDFIAAAA==';

// The work, counted. The stories themselves live on the homepage; this page links to them once.
const stories = (await getCollection('stories', (story) => !story.data.draft)).sort(compareStories);
const frameTotal = stories.reduce((sum, story) => sum + storyFrames(story.body ?? '', story.data.cover).length, 0);

// The portrait was made at home, at the foot of Rattlesnake Mountain.
const homeCoords = `${formatCoordinates({ latitude: 47.4896, longitude: -121.7854 })} · 158 m`;

const roles = [
  { title: 'Documentarian', desc: "Records what's disappearing." },
  { title: 'Architect', desc: 'Designs the systems underneath.' },
  { title: 'Frontier tech.', desc: 'Deploys it. Funds it.' },
];

const kit = [
  { label: 'Body · primary', value: 'Canon R5 Mark II' },
  { label: 'Body · compact', value: 'Leica Q2' },
  { label: 'Body · film', value: 'Canon EOS 3' },
  { label: 'Lens · prime', value: 'RF 35mm ƒ/1.4L VCM' },
  { label: 'Lens · zoom', value: 'RF 24–70mm ƒ/2.8L IS' },
  { label: 'Lens · tele', value: 'RF 70–200mm ƒ/2.8L IS' },
  { label: 'Aerial', value: 'DJI Mavic 3 Pro' },
  { label: 'Site', value: 'Astro · DigitalOcean' },
];

const contacts = [
  { label: 'Email', value: 'corbin@heist.studio', href: 'mailto:corbin@heist.studio' },
  { label: 'Substack', value: 'corbinheist.substack.com', href: 'https://corbinheist.substack.com' },
  { label: 'Instagram', value: '@corbinheist', href: 'https://instagram.com/corbinheist' },
];
---

<SiteLayout title="About" description="I live at the foot of Rattlesnake Mountain. The camera comes because I'm going anyway.">
  <div class="about" data-lightbox-scope>

    {/* The portrait plate and the text beside it. */}
    <section class="about-hero">
      <figure class="about-portrait" data-frame="1" style="--ratio: 0.667">
        <div class="about-portrait__plate">
          <picture>
            <source
              type="image/avif"
              srcset={`${portraitBase}/about-portrait-640.avif 640w, ${portraitBase}/about-portrait-750.avif 750w, ${portraitBase}/about-portrait-1080.avif 1080w`}
              sizes="(max-width: 899px) 100vw, 40vw"
            />
            <source
              type="image/webp"
              srcset={`${portraitBase}/about-portrait-640.webp 640w, ${portraitBase}/about-portrait-750.webp 750w, ${portraitBase}/about-portrait-1080.webp 1080w`}
              sizes="(max-width: 899px) 100vw, 40vw"
            />
            <img
              src={`${portraitBase}/about-portrait-1080.webp`}
              alt="Corbin Heist"
              width="1366"
              height="2048"
              loading="eager"
              decoding="async"
              style={`background-image: url(${portraitLqip}); background-size: cover;`}
            />
          </picture>
          <p class="about-coords tabular">{homeCoords}</p>
        </div>
        <figcaption class="about-caption">Self · Leica M11 · 50mm · ƒ/2</figcaption>
      </figure>

      <div class="about-hero__text">
        <p class="label">About — field notes on a practice</p>
        <h1 class="about-headline">
          The camera comes<br/>
          <em>because</em>{' '}
          <br/>I'm going anyway.
        </h1>

        <p class="about-body">
          I live at the foot of Rattlesnake Mountain, in a small town at
          the top of the Snoqualmie Valley. On a good day I'm up with
          first light through the Douglas firs, coffee by the fire on
          the balcony, and by afternoon I'm climbing the same ridge
          until the trees break.
        </p>
        <p class="about-body">
          Sometimes I travel to industrial towns, port cities, the kind
          of nowhere that doesn't make anyone's must-visit list. The
          camera comes because I'm going anyway. The best photographs
          I've brought home started as a two-hour detour.
        </p>

        <ul class="about-roles">
          {roles.map((role) => <li><span class="about-roles__title">{role.title}</span> {role.desc}</li>)}
        </ul>
      </div>
    </section>

    {/* The work, once: totals and one link. */}
    <p class="about-work">
      <span class="tabular">{stories.length} stories · {frameTotal} frames</span>
      <a href="/#work">All work <span aria-hidden="true">→</span></a>
    </p>

    {/* Plate 002 */}
    <figure class="about-plate" data-frame="2" style="--ratio: 1.499">
      <picture>
        <source
          type="image/avif"
          srcset={`${ksarBase}/heist-ksar-essay-001-cnh_3628-640.avif 640w, ${ksarBase}/heist-ksar-essay-001-cnh_3628-1080.avif 1080w, ${ksarBase}/heist-ksar-essay-001-cnh_3628-1600.avif 1600w, ${ksarBase}/heist-ksar-essay-001-cnh_3628-2400.avif 2400w`}
          sizes="(max-width: 899px) 100vw, 90vw"
        />
        <source
          type="image/webp"
          srcset={`${ksarBase}/heist-ksar-essay-001-cnh_3628-640.webp 640w, ${ksarBase}/heist-ksar-essay-001-cnh_3628-1080.webp 1080w, ${ksarBase}/heist-ksar-essay-001-cnh_3628-1600.webp 1600w, ${ksarBase}/heist-ksar-essay-001-cnh_3628-2400.webp 2400w`}
          sizes="(max-width: 899px) 100vw, 90vw"
        />
        <img
          src={`${ksarBase}/heist-ksar-essay-001-cnh_3628-1600.webp`}
          alt="Ksar Tamnougalt at the edge of the Sahara, Morocco"
          width="8192"
          height="5464"
          loading="lazy"
          decoding="async"
          style={`background-image: url(${ksarLqip}); background-size: cover;`}
        />
      </picture>
      <figcaption class="about-caption">
        <span>Ksar at the edge of the Sahara · Morocco, 2024</span>
        <span>Canon R5 · 50mm · ƒ/4 · 1/1000s</span>
      </figcaption>
    </figure>

    {/* Correspondence, commissions, and kit: one column. */}
    <section class="about-column" id="contact">
      <p class="label">Correspondence</p>
      <h2 class="about-heading">Sometimes my path crosses yours. Same town, same trail, same morning.</h2>
      <p class="about-body about-body--muted">
        Write when it does.
        I'll either write back or I won't. Both are honest answers.
      </p>

      <p class="label about-column__label">Commissions</p>
      <p class="about-body">I take a small number of commissions each year: documentary work with people whose work is outdoors. Write with the place, the dates, and what the pictures are for.</p>

      <ul class="about-rows">
        {contacts.map((c) => (
          <li>
            <a href={c.href} target={c.href.startsWith('mailto') ? undefined : '_blank'} rel={c.href.startsWith('mailto') ? undefined : 'noopener'}>
              <span class="about-rows__label">{c.label}</span>
              <span>{c.value}</span>
              <span class="about-rows__arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>

      <p class="label about-column__label">Kit</p>
      <h2 class="about-heading">What it's made on.</h2>
      <ul class="about-rows">
        {kit.map((item) => (
          <li><span class="about-rows__label">{item.label}</span><span>{item.value}</span></li>
        ))}
      </ul>
    </section>

    <Lightbox />
  </div>

  <script>
    import { initLightbox } from '@scripts/lightbox';
    initLightbox();
  </script>
</SiteLayout>

<style>
  /* About: the same plates on paper, marginalia, and measure as a story. One column of text. */
  .about {
    padding: var(--space-lg) var(--container-padding) var(--space-3xl);
    max-width: var(--container-max);
    margin-inline: auto;
  }

  .label {
    margin-bottom: var(--space-sm);
  }

  .about-caption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.3em 1.2em;
    margin-top: var(--space-sm);
    font-size: var(--type-margin);
    color: var(--color-text-muted);
  }

  .about-coords {
    margin-top: var(--space-sm);
    font-size: var(--type-margin);
    color: var(--color-text-muted);
  }

  .about-portrait picture {
    display: block;
  }

  .about-portrait img,
  .about-plate img {
    display: block;
    width: 100%;
    height: auto;
    background-repeat: no-repeat;
    background-position: center;
  }

  .about-hero__text {
    margin-top: var(--space-xl);
  }

  .about-headline {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: var(--type-title);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .about-headline em {
    font-style: italic;
    color: inherit;
  }

  .about-body {
    max-width: 32.5rem;
    margin-top: var(--space-md);
    font-size: var(--type-body);
    line-height: 1.7;
    color: var(--color-text);
  }

  .about-body--muted {
    color: var(--color-text-muted);
  }

  .about-headline + .about-body {
    margin-top: var(--space-lg);
  }

  .about-roles {
    max-width: 32.5rem;
    margin-top: var(--space-lg);
    font-size: var(--type-body);
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .about-roles__title {
    color: var(--color-text);
  }

  /* The work, once. */
  .about-work {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-sm);
    max-width: none;
    margin-block: var(--space-3xl) 0;
    padding-block: var(--space-md);
    border-block: 1px solid var(--color-border);
    font-size: var(--type-margin);
    color: var(--color-text-muted);
  }

  .about-work a {
    color: var(--color-text);
    transition: color 160ms ease;
  }

  .about-work a:hover {
    color: var(--color-accent);
  }

  .about-plate {
    margin-top: var(--space-3xl);
  }

  /* One column at the text measure, set in from the left. */
  .about-column {
    max-width: 32.5rem;
    margin-top: var(--space-3xl);
  }

  .about-heading {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: var(--type-heading);
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--color-text);
    text-wrap: balance;
  }

  .about-column__label {
    margin-top: var(--space-2xl);
  }

  .about-rows {
    margin-top: var(--space-lg);
    font-size: var(--type-margin);
  }

  .about-rows li {
    border-bottom: 1px solid var(--color-border);
  }

  .about-rows li > a,
  .about-rows li:not(:has(a)) {
    display: grid;
    grid-template-columns: 8.5rem 1fr auto;
    gap: var(--space-md);
    padding-block: 0.9em;
    color: var(--color-text);
  }

  .about-rows__label {
    color: var(--color-text-muted);
  }

  .about-rows a:hover span:not(.about-rows__label) {
    color: var(--color-accent);
  }

  .about-rows__arrow {
    color: var(--color-text-muted);
  }

  @media (min-width: 900px) {
    .about {
      padding-top: 0.75rem;
    }

    /* The portrait fills the first screen's height on the right; the text holds the field beside it. */
    .about-hero {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--space-md);
      align-items: start;
    }

    .about-portrait {
      grid-column: 7 / -1;
      grid-row: 1;
      justify-self: end;
    }

    .about-portrait__plate {
      display: flex;
      align-items: flex-start;
      gap: var(--space-sm);
    }

    .about-portrait picture {
      width: min(100% - 2.5rem, (100svh - var(--header-h) - 4rem) * var(--ratio));
    }

    .about-coords {
      margin-top: 0;
      writing-mode: vertical-rl;
    }

    .about-hero__text {
      grid-column: 1 / 7;
      grid-row: 1;
      margin-top: 0;
    }

    .about-plate {
      width: min(100%, 90svh * var(--ratio));
      margin-inline: auto 0;
    }

    .about-column {
      margin-left: calc(100% / 12);
    }
  }
</style>
