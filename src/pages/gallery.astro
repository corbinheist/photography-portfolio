---
import { getCollection } from 'astro:content';
import SiteLayout from '@layouts/SiteLayout.astro';
import Photo from '@components/photo/Photo.astro';
import Lightbox from '@components/story/Lightbox.astro';
import { compareStories, formatStoryDate, loadGalleryExtras, loadManifest, resolvePhoto, storyFrames } from '@scripts/utils/story-manifest';

// Every photograph from every published story, plus the gallery-only photographs
// (src/data/gallery-extras.yaml). Newest first by date; a story's frames stay in reading order.
// A click opens a photograph full bleed in the lightbox; the arrows move through the whole wall.
const stories = (await getCollection('stories', (story) => !story.data.draft)).sort(compareStories);

type Frame = { key: string; photo: { url: string; width: number; height: number; lqip: string; alt: string }; label: string };

const storyGroups = stories.map((story) => {
  const manifest = loadManifest(story.id);
  const frames: Frame[] = storyFrames(story.body ?? '', story.data.cover).map((id, index) => {
    const num = String(index + 1).padStart(2, '0');
    return {
      key: `${story.id}-${id}`,
      photo: resolvePhoto(story.id, manifest, id),
      label: `${story.data.title} · ${num}`,
    };
  });
  return { data: { date: story.data.date, order: story.data.order }, frames };
});

const extraGroups = loadGalleryExtras().map((photo) => ({
  data: { date: photo.date, order: 0 },
  frames: [{ key: `extra-${photo.id}`, photo, label: `${photo.place} · ${formatStoryDate(photo.date)}` }] as Frame[],
}));

const frames = [...storyGroups, ...extraGroups].sort(compareStories).flatMap((group) => group.frames);
---

<SiteLayout title="Gallery · Heist Studio" description={`Every photograph on heist.studio: ${frames.length} frames.`}>
  <section class="gallery" data-lightbox-scope>
    <!-- The navigation marks this page; the heading is for screen readers only. -->
    <h1 class="visually-hidden">Gallery</h1>
    <p class="gallery__count label tabular">{frames.length} frames · {stories.length} stories</p>

    <ul class="gallery__wall">
      {frames.map((frame, index) => (
        <li style={`--ratio: ${frame.photo.width / frame.photo.height}`}>
          <figure class="gallery__frame" data-frame={index + 1}>
            <Photo url={frame.photo.url} width={frame.photo.width} height={frame.photo.height} lqip={frame.photo.lqip} alt={frame.photo.alt} sizes="(max-width: 767px) 50vw, (max-width: 1399px) 33vw, 25vw" />
            <figcaption class="visually-hidden">{frame.label}</figcaption>
          </figure>
        </li>
      ))}
    </ul>

    <Lightbox />
  </section>

  <script>
    import { initLightbox } from '@scripts/lightbox';
    initLightbox();
  </script>
</SiteLayout>

<style>
  .gallery {
    padding: clamp(2rem, 5vw, 3.5rem) var(--container-padding) 0;
  }

  .gallery__count {
    margin-bottom: var(--space-md);
  }

  /* Justified rows: every frame keeps its full proportions (no crop), each row has one height,
     and the order reads left to right, newest story first. */
  .gallery__wall {
    --row-h: 9rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  @media (min-width: 768px) {
    .gallery__wall { --row-h: 13rem; gap: 0.75rem; }
  }

  @media (min-width: 1400px) {
    .gallery__wall { --row-h: 15rem; }
  }

  .gallery__wall li {
    flex-grow: calc(var(--ratio) * 100);
    flex-basis: calc(var(--ratio) * var(--row-h));
  }

  /* Stops the last row from stretching its few frames across the full width. */
  .gallery__wall::after {
    content: '';
    flex-grow: 1000000;
  }

  .gallery__frame {
    position: relative;
    display: block;
  }

  /* The photographs as shot: no dimming, no caption on the photograph. */
  .gallery__frame :global(img) {
    width: 100%;
    height: auto;
  }
</style>
