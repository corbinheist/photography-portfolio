---
import { getCollection } from 'astro:content';
import SiteLayout from '@layouts/SiteLayout.astro';
import Photo from '@components/photo/Photo.astro';
import StoryHero from '@components/story/StoryHero.astro';
import { buildPhotoUrl } from '@scripts/utils/photo-widths';
import { compareStories, formatCoordinates, formatStoryDate, loadManifest, placeName, resolvePhoto, storyFrames, storyUrl } from '@scripts/utils/story-manifest';

// The homepage reads like a story: the lead story's cover (jo), one plate per other story (ha),
// and a quiet contents list (kyū). Featured stories are numbered from the oldest (№ 01).
const published = (await getCollection('stories', (story) => !story.data.draft)).sort(compareStories);
const featuredCount = published.filter((story) => story.data.featured).length;

const entries = published
  .sort((a, b) => Number(b.data.featured ?? false) - Number(a.data.featured ?? false))
  .map((story, index) => {
    const manifest = loadManifest(story.id);
    const { coordinates, elevation_m } = story.data;
    return {
      story,
      href: storyUrl(story.id),
      number: story.data.featured ? String(featuredCount - index).padStart(2, '0') : undefined,
      frames: storyFrames(story.body ?? '', story.data.cover).length,
      cover: resolvePhoto(story.id, manifest, story.data.cover),
      year: story.data.date.slice(0, 4),
      coords: [coordinates && formatCoordinates(coordinates), elevation_m !== undefined && `${elevation_m.toLocaleString('en-GB')} m`].filter(Boolean).join(' · '),
    };
  });

const [lead, ...plates] = entries;
---

<SiteLayout
  title="Heist Studio · Corbin Heist"
  description="Documentary photography of people and the work they do outdoors."
  image={lead && buildPhotoUrl(lead.cover.url, lead.cover.width, 1600)}
  navDefault="bar"
>
  <h1 class="visually-hidden">Heist Studio, documentary photography by Corbin Heist</h1>

  {lead && (
    <StoryHero
      photo={lead.cover}
      title={lead.story.data.title}
      summary={lead.story.data.summary}
      overline={lead.number && `№ ${lead.number}`}
      margin={[lead.story.data.place, formatStoryDate(lead.story.data.date)]}
      coords={lead.coords || undefined}
      cta={{
        href: lead.href,
        // The call to action names the place the story goes to; the accessible name adds the title.
        label: `Go to ${placeName(lead.story.data.place)}`,
        ariaLabel: `Go to ${placeName(lead.story.data.place)}: ${lead.story.data.title}`,
      }}
      transitionName={`cover-${lead.story.id}`}
      headingLevel="h2"
      bleed
    />
  )}

  {/* Ha: one plate per story, off-centre, alternating sides. Each plate opens its story. */}
  <section id="work" class="plates" aria-label="Stories">
    {plates.map(({ story, href, number, cover, year, coords }) => (
      <a href={href} class="plate" style={`--ratio: ${cover.width / cover.height}`}>
        <span class="plate__media">
          <span class="plate__photo" style={`view-transition-name: cover-${story.id}`}>
            <Photo url={cover.url} width={cover.width} height={cover.height} lqip={cover.lqip} alt={cover.alt} sizes="(max-width: 899px) 100vw, 66vw" />
          </span>
          {coords && <span class="plate__coords tabular">{coords}</span>}
        </span>
        <span class="plate__text">
          {number && <span class="plate__num tabular">№ {number}</span>}
          <span class="plate__title">{story.data.title}</span>
          <span class="plate__place">{story.data.place} · {year}</span>
        </span>
      </a>
    ))}
  </section>

  {/* Kyū: the contents, quiet. One hairline row per story. */}
  <section class="contents" aria-labelledby="contents-heading">
    <h2 id="contents-heading" class="label">Contents</h2>
    <ol>
      {entries.map(({ href, number, story, year }) => (
        <li>
          <a href={href} class="contents__row">
            <span class="contents__num tabular">{number && `№ ${number}`}</span>
            <span class="contents__title">{story.data.title}</span>
            <span class="contents__place">{story.data.place}</span>
            <span class="contents__year tabular">{year}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="outro">
    <p class="outro__line">I live at the foot of Rattlesnake Mountain, in the Snoqualmie Valley. The camera comes because I'm going anyway.</p>
    <p class="outro__commission">Have a story worth spending time with? I take a small number of documentary and editorial commissions each year.</p>
    <a class="outro__email" href="mailto:corbin@heist.studio">corbin@heist.studio</a>
  </section>
</SiteLayout>

<style>
  /* ── Plates ── */
  .plates {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xl);
    max-width: var(--container-max);
    margin: var(--space-3xl) auto 0;
    padding-inline: var(--container-padding);
  }

  .plate {
    display: block;
  }

  .plate__media {
    display: flex;
    flex-direction: column;
  }

  .plate__photo {
    display: block;
  }

  .plate__photo :global(img) {
    width: 100%;
    height: auto;
  }

  .plate__coords,
  .plate__place,
  .plate__num {
    font-size: var(--type-margin);
    color: var(--color-text-muted);
  }

  .plate__coords {
    margin-top: var(--space-sm);
  }

  .plate__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    margin-top: var(--space-md);
  }

  .plate__title {
    font-family: var(--font-heading);
    font-size: var(--type-heading);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-text);
    transition: color 160ms ease;
  }

  .plate:hover .plate__title {
    color: var(--color-accent);
  }

  @media (min-width: 900px) {
    /* A plate is at most two thirds of the row and 80svh high, one twelfth in from the left
       edge, then from the right, in turn. The coordinates run down its outer edge. */
    .plate {
      width: fit-content;
      max-width: 100%;
      margin-left: calc(100% / 12);
    }

    .plate:nth-child(even) {
      margin-left: auto;
      margin-right: calc(100% / 12);
    }

    .plate__media {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--space-sm);
    }

    .plate:nth-child(even) .plate__media {
      flex-direction: row-reverse;
    }

    .plate__photo {
      width: min(66.667vw - 2 * var(--container-padding), 80svh * var(--ratio));
    }

    .plate__coords {
      margin-top: 0;
      writing-mode: vertical-rl;
    }

    .plate:nth-child(even) .plate__text {
      align-items: flex-end;
      text-align: right;
    }
  }

  /* ── Contents ── */
  .contents {
    max-width: var(--container-max);
    margin: var(--space-3xl) auto 0;
    padding-inline: var(--container-padding);
  }

  .contents h2,
  .contents ol {
    max-width: 56rem;
  }

  .contents h2 {
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--color-border);
  }

  .contents li {
    border-bottom: 1px solid var(--color-border);
  }

  .contents__row {
    display: grid;
    grid-template-columns: 5ch 1fr;
    gap: 0.2em var(--space-md);
    padding-block: 0.9em;
    align-items: baseline;
  }

  .contents__num,
  .contents__place,
  .contents__year {
    font-size: var(--type-margin);
    color: var(--color-text-muted);
  }

  .contents__title {
    font-family: var(--font-heading);
    font-size: var(--type-body);
    color: var(--color-text);
    transition: color 160ms ease;
  }

  .contents__place {
    grid-column: 2;
  }

  .contents__year {
    display: none;
  }

  .contents__row:hover .contents__title {
    color: var(--color-accent);
  }

  @media (min-width: 900px) {
    .contents {
      padding-left: calc(var(--container-padding) + (100% - 2 * var(--container-padding)) / 12);
    }

    .contents__row {
      grid-template-columns: 5ch minmax(0, 1.4fr) minmax(0, 1fr) 5ch;
    }

    .contents__place {
      grid-column: auto;
    }

    .contents__year {
      display: block;
      text-align: right;
    }
  }

  /* ── Close ── */
  .outro {
    max-width: calc(32.5rem + 2 * var(--container-padding));
    padding: var(--space-3xl) var(--container-padding) 0;
  }

  .outro__line {
    font-family: var(--font-heading);
    font-size: var(--type-heading);
    line-height: 1.35;
  }

  .outro__commission {
    margin-top: var(--space-md);
    color: var(--color-text-muted);
  }

  .outro__email {
    display: inline-block;
    margin-top: var(--space-md);
    font-size: var(--type-margin);
    color: var(--color-text);
    border-bottom: 1px solid currentColor;
  }

  .outro__email:hover {
    color: var(--color-accent);
  }
</style>
