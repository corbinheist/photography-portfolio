---
import { getCollection } from 'astro:content';
import SiteLayout from '@layouts/SiteLayout.astro';
import Photo from '@components/photo/Photo.astro';
import StoryHero from '@components/story/StoryHero.astro';
import { buildPhotoUrl } from '@scripts/utils/photo-widths';
import { compareStories, formatCoordinates, formatStoryDate, loadManifest, placeName, resolvePhoto, storyFrames, storyUrl } from '@scripts/utils/story-manifest';

const published = (await getCollection('stories', (story) => !story.data.draft)).sort(compareStories);

// Featured stories lead: the hero and the numbered index. The others list under "More stories".
const stories = published
  .filter((story) => story.data.featured)
  .map((story, index, featured) => {
    const manifest = loadManifest(story.id);
    const order = storyFrames(story.body ?? '', story.data.cover);
    const cover = resolvePhoto(story.id, manifest, story.data.cover);
    // The lead story's hero already shows its cover, so its index row uses the next photograph.
    const thumbId = index === 0 ? order.find((id) => id !== story.data.cover) ?? story.data.cover : story.data.cover;
    return {
      story,
      href: storyUrl(story.id),
      // Numbered from the oldest (№ 01); the list shows the newest first.
      number: String(featured.length - index).padStart(2, '0'),
      frames: order.length,
      cover,
      thumb: resolvePhoto(story.id, manifest, thumbId),
    };
  });

const [lead] = stories;
// The lead story's coordinates and elevation run down the hero's edge, as on a story.
const leadCoords = lead && [
  lead.story.data.coordinates && formatCoordinates(lead.story.data.coordinates),
  lead.story.data.elevation_m !== undefined && `${lead.story.data.elevation_m.toLocaleString('en-GB')} m`,
].filter(Boolean).join(' · ');

const more = published
  .filter((story) => !story.data.featured)
  .map((story) => {
    const manifest = loadManifest(story.id);
    return {
      story,
      href: storyUrl(story.id),
      frames: storyFrames(story.body ?? '', story.data.cover).length,
      cover: resolvePhoto(story.id, manifest, story.data.cover),
    };
  });
---

<SiteLayout
  title="Heist Studio · Corbin Heist"
  description="Documentary photography of people and the work they do outdoors."
  image={lead && buildPhotoUrl(lead.cover.url, lead.cover.width, 1600)}
  navDefault="bar"
>
  {lead && (
    <StoryHero
      photo={lead.cover}
      title={lead.story.data.title}
      summary={lead.story.data.summary}
      overline={`№ ${lead.number}`}
      margin={[lead.story.data.place, formatStoryDate(lead.story.data.date)]}
      coords={leadCoords || undefined}
      cta={{
        href: lead.href,
        // The call to action names the place the story goes to; the accessible name adds the title.
        label: `Go to ${placeName(lead.story.data.place)}`,
        ariaLabel: `Go to ${placeName(lead.story.data.place)}: ${lead.story.data.title}`,
      }}
      transitionName={`cover-${lead.story.id}`}
      headingLevel="h2"
      bleed
    />
  )}

  <section id="work" class="ledger" aria-labelledby="work-heading">
    <h1 class="visually-hidden">Heist Studio, documentary photography by Corbin Heist</h1>
    <header class="ledger__head">
      <h2 id="work-heading" class="label">Selected stories</h2>
      <p class="label tabular">{stories.length} stories · {stories.reduce((sum, s) => sum + s.frames, 0)} frames</p>
    </header>
    <ol>
      {stories.map(({ story, href, number, frames, thumb }, index) => (
        <li>
          <a href={href} class="ledger__row">
            <span class="ledger__num label tabular">№ {number}</span>
            <span class="ledger__thumb" style={index > 0 ? `view-transition-name: cover-${story.id}` : undefined}>
              <Photo url={thumb.url} width={thumb.width} height={thumb.height} lqip={thumb.lqip} alt={thumb.alt} sizes="(max-width: 767px) 100vw, 360px" />
            </span>
            <span class="ledger__text">
              <span class="ledger__title">{story.data.title}</span>
              <span class="ledger__summary">{story.data.summary}</span>
              {story.data.client && <span class="ledger__client label">Commission · {story.data.client}</span>}
            </span>
            <span class="ledger__facts label tabular">
              <span>{story.data.place}</span>
              <span>{formatStoryDate(story.data.date)}</span>
              <span class="ledger__frames">{frames} frames</span>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  {more.length > 0 && (
    <section class="more" aria-labelledby="more-heading">
      <header class="ledger__head">
        <h2 id="more-heading" class="label">More stories</h2>
        <p class="label tabular">{more.length} stories · {more.reduce((sum, s) => sum + s.frames, 0)} frames</p>
      </header>
      <ul class="more__grid">
        {more.map(({ story, href, frames, cover }) => (
          <li>
            <a href={href} class="more__card">
              <span class="more__thumb" style={`view-transition-name: cover-${story.id}`}>
                <Photo url={cover.url} width={cover.width} height={cover.height} lqip={cover.lqip} alt={cover.alt} sizes="(max-width: 767px) 100vw, 33vw" />
              </span>
              <span class="more__title">{story.data.title}</span>
              <span class="label tabular">{story.data.place} · {formatStoryDate(story.data.date)} · <span class="ledger__frames">{frames} frames</span></span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="outro">
    <p class="outro__line">I live at the foot of Rattlesnake Mountain, in the Snoqualmie Valley. The camera comes because I'm going anyway.</p>
    <p class="outro__commission">Have a story worth spending time with? I take a small number of documentary and editorial commissions each year.</p>
    <a class="outro__email" href="mailto:corbin@heist.studio">corbin@heist.studio</a>
  </section>
</SiteLayout>

<style>
  .ledger {
    padding: clamp(1.5rem, 3vw, 2.5rem) var(--container-padding) 0;
  }

  .ledger__head {
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--color-border);
  }

  .ledger__head h2 {
    font-weight: 400;
  }

  .ledger li {
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .ledger__row {
    display: grid;
    grid-template-columns: 7ch minmax(220px, 360px) 1fr 22ch;
    gap: clamp(1rem, 2.5vw, 2.5rem);
    align-items: start;
    padding-block: clamp(1.5rem, 3vw, 2.5rem);
  }

  .ledger__num {
    padding-top: 0.35em;
  }

  .ledger__thumb :global(img) {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .ledger__text {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .ledger__title {
    font-family: var(--font-heading);
    font-size: var(--type-heading);
    line-height: 1.08;
    letter-spacing: -0.02em;
    transition: color 200ms ease;
  }

  .ledger__summary {
    max-width: 52ch;
    color: var(--color-text-muted);
  }

  .ledger__client {
    margin-top: var(--space-xs);
    color: var(--color-text-muted);
  }

  .ledger__facts {
    display: flex;
    flex-direction: column;
    gap: 0.5em;
    text-align: right;
    padding-top: 0.35em;
  }

  .ledger__frames {
    color: var(--color-text-muted);
  }

  .ledger__row:hover .ledger__title {
    color: var(--color-accent);
  }

  @media (max-width: 899px) {
    .ledger__row {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
    }

    .ledger__num { order: 2; padding-top: 0; }
    .ledger__thumb { order: 1; }
    .ledger__text { order: 3; }

    .ledger__facts {
      order: 4;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0 1.2em;
      text-align: left;
    }
  }

  .more {
    padding: clamp(4rem, 8vw, 6rem) var(--container-padding) 0;
  }

  .more__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: var(--space-xl) var(--space-lg);
    padding-top: var(--space-lg);
  }

  .more__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .more__thumb :global(img) {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .more__title {
    margin-top: var(--space-xs);
    font-family: var(--font-heading);
    font-size: var(--type-heading);
    line-height: 1.1;
    letter-spacing: -0.02em;
    transition: color 200ms ease;
  }

  .more__card:hover .more__title {
    color: var(--color-accent);
  }

  .outro {
    max-width: calc(32.5rem + 2 * var(--container-padding));
    padding: clamp(5rem, 10vw, 8rem) var(--container-padding) 0;
  }

  .outro__line {
    font-family: var(--font-heading);
    font-size: var(--type-heading);
    line-height: 1.35;
  }

  .outro__commission {
    margin-top: var(--space-md);
    color: var(--color-text-muted);
  }

  .outro__email {
    display: inline-block;
    margin-top: var(--space-md);
    font-variant-numeric: tabular-nums;
    font-size: var(--type-margin);
    color: var(--color-text);
    border-bottom: 1px solid currentColor;
  }

  .outro__email:hover {
    color: var(--color-accent);
  }
</style>
