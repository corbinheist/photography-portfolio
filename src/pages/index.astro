---
import { getCollection } from 'astro:content';
import SiteLayout from '@layouts/SiteLayout.astro';
import Photo from '@components/photo/Photo.astro';
import { buildPhotoUrl } from '@scripts/utils/photo-widths';
import { formatStoryDate, loadManifest, resolvePhoto, storyUrl } from '@scripts/utils/story-manifest';

const stories = (await getCollection('stories', (story) => !story.data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .map((story) => ({ story, cover: resolvePhoto(story.id, loadManifest(story.id), story.data.cover) }));

const [lead] = stories;
---

<SiteLayout
  title="Corbin Heist"
  description="Documentary photography of people and the work they do outdoors."
  image={lead && buildPhotoUrl(lead.cover.url, lead.cover.width, 1600)}
>
  {lead && (
    <a href={storyUrl(lead.story.id, lead.story.data.url)} class="home-hero">
      <Photo url={lead.cover.url} width={lead.cover.width} height={lead.cover.height} lqip={lead.cover.lqip} alt={lead.cover.alt} sizes="100vw" loading="eager" fetchpriority="high" />
    </a>
  )}

  <section class="home-intro">
    <!-- PENDING APPROVAL (STU-20): positioning sentence, option A. -->
    <h1 class="home-intro__line">
      Documentary photography of people and the work they do outdoors: nomad families in the High Atlas, ultrarunners in the Bougmez, kissaten counters in Tokyo.
    </h1>
  </section>

  <ol class="home-stories">
    {stories.map(({ story, cover }) => (
      <li>
        <a href={storyUrl(story.id, story.data.url)} class="home-story">
          <Photo url={cover.url} width={cover.width} height={cover.height} lqip={cover.lqip} alt={cover.alt} sizes="(max-width: 767px) 100vw, 50vw" />
          <p class="home-story__meta">{[story.data.place, formatStoryDate(story.data.date), story.data.client].filter(Boolean).join(' · ')}</p>
          <h2 class="home-story__title">{story.data.title}</h2>
          <p class="home-story__summary">{story.data.summary}</p>
        </a>
      </li>
    ))}
  </ol>

  <section class="home-outro">
    <p>I live at the foot of Rattlesnake Mountain, in the Snoqualmie Valley. The camera comes because I'm going anyway.</p>
    <p><a href="mailto:corbin@heist.studio">corbin@heist.studio</a></p>
  </section>
</SiteLayout>

<style>
  .home-hero :global(img) {
    width: 100%;
    max-height: 85svh;
    object-fit: cover;
  }

  .home-intro,
  .home-outro {
    width: min(41rem, 100% - 2 * var(--container-padding));
    margin: var(--space-2xl) auto;
  }

  .home-intro__line {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: -0.02em;
  }

  .home-stories {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 28rem), 1fr));
    gap: var(--space-2xl) var(--space-xl);
    padding-inline: var(--container-padding);
  }

  .home-story :global(img) {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
  }

  .home-story__meta {
    margin-top: var(--space-sm);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .home-story__title {
    margin-top: var(--space-xs);
    font-family: var(--font-heading);
    font-size: var(--text-xl);
    font-weight: 400;
    letter-spacing: -0.02em;
  }

  .home-story__summary {
    margin-top: var(--space-xs);
    color: var(--color-text-muted);
  }

  .home-story:hover .home-story__title {
    color: var(--color-accent);
  }

  .home-outro {
    color: var(--color-text-muted);
  }

  .home-outro a {
    color: var(--color-accent);
  }
</style>
