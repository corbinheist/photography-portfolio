---
import { getCollection, render } from 'astro:content';
import StoryLayout from '@layouts/StoryLayout.astro';
import Image from '@components/story/Image.astro';
import Pair from '@components/story/Pair.astro';
import Quote from '@components/story/Quote.astro';
import { loadManifest, storyUrl } from '@scripts/utils/story-manifest';

export async function getStaticPaths() {
  // STORIES_INCLUDE_DRAFTS=1 builds draft stories for a local preview. Production builds omit them.
  const includeDrafts = process.env.STORIES_INCLUDE_DRAFTS === '1';
  const stories = (await getCollection('stories', (entry) => includeDrafts || !entry.data.draft))
    .sort((a, b) => a.data.order - b.data.order);
  return stories.map((story, index) => ({
    params: { story: storyUrl(story.id, story.data.url).replace(/^\/work\/|\/$/g, '') },
    props: { story, next: stories.length > 1 ? stories[(index + 1) % stories.length] : undefined },
  }));
}

const { story, next } = Astro.props;
const photos = loadManifest(story.id);
Astro.locals.story = { slug: story.id, photos };
const { Content } = await render(story);
---

<StoryLayout story={story} photos={photos} next={next}>
  <Content components={{ Image, Pair, Quote }} />
</StoryLayout>
