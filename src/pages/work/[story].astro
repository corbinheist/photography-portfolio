---
import { getCollection, render } from 'astro:content';
import StoryLayout from '@layouts/StoryLayout.astro';
import Image from '@components/story/Image.astro';
import Pair from '@components/story/Pair.astro';
import Quote from '@components/story/Quote.astro';
import { compareStories, loadManifest, storyFrames, storyUrl } from '@scripts/utils/story-manifest';

export async function getStaticPaths() {
  // STORIES_INCLUDE_DRAFTS=1 builds draft stories for a local preview. Production builds omit them.
  const includeDrafts = process.env.STORIES_INCLUDE_DRAFTS === '1';
  const stories = (await getCollection('stories', (entry) => includeDrafts || !entry.data.draft))
    .sort(compareStories);
  // Featured stories are numbered from the oldest (№ 01) to the newest; they list newest first.
  // Previous and next stay within a story's own tier.
  return stories.map((story) => {
    const tier = stories.filter((other) => other.data.featured === story.data.featured);
    const index = tier.indexOf(story);
    return {
      params: { story: story.id },
      props: {
        story,
        number: story.data.featured ? tier.length - index : undefined,
        prev: index > 0 ? tier[index - 1] : undefined,
        next: index < tier.length - 1 ? tier[index + 1] : undefined,
      },
    };
  });
}

const { story, number, prev, next } = Astro.props;
const photos = loadManifest(story.id);
const order = storyFrames(story.body ?? '', story.data.cover);
Astro.locals.story = { slug: story.id, photos, numbers: new Map(order.map((id, index) => [id, index + 1])), anchored: new Set() };
const { Content } = await render(story);
---

<StoryLayout story={story} photos={photos} number={number} frames={order.length} prev={prev} next={next}>
  <Content components={{ Image, Pair, Quote }} />
</StoryLayout>
