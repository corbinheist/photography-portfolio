---
import SiteLayout from '@layouts/SiteLayout.astro';
import Photo from '@components/photo/Photo.astro';
import Lightbox from '@components/story/Lightbox.astro';
import { formatEverydayDate, loadEveryday } from '@scripts/utils/everyday';
import { formatCoordinates } from '@scripts/utils/story-manifest';

// The Everyday page: the Apple Photos album EDC, newest first. `pnpm everyday sync` writes the
// manifest (src/data/everyday.yaml). A masonry grid; a click opens the lightbox (the photograph alone).
// Each frame has a small paper tab at its short edge: the capture date, and the coordinates where the
// frame has them. From 900px a landscape frame carries it on its right side; otherwise it sits under.
const frames = loadEveryday().map((photo, index) => ({
  photo,
  number: index + 1,
  orientation: photo.width >= photo.height ? 'landscape' : 'portrait',
  date: formatEverydayDate(photo.date),
  coordinates: photo.coordinates ? formatCoordinates(photo.coordinates) : undefined,
}));
---

<SiteLayout title="Everyday · Heist Studio" description="Everyday photographs, newest first, from the iPhone and the Ricoh GR IIIx.">
  <section class="everyday" data-lightbox-scope>
    <h1 class="visually-hidden">Everyday</h1>

    {frames.length === 0 ? (
      <p class="everyday__empty">No photographs yet.</p>
    ) : (
      <ul class="everyday__wall">
        {frames.map(({ photo, number, orientation, date, coordinates }) => (
          <li class={`everyday__item--${orientation}`}>
            <figure class="everyday__frame" data-frame={number}>
              <Photo url={photo.url} width={photo.width} height={photo.height} lqip={photo.lqip} alt={photo.alt} sizes="(max-width: 767px) 50vw, (max-width: 1399px) 33vw, 25vw" />
              <figcaption class="everyday__tab label tabular">
                <span>{date}</span>
                {coordinates && <span>{coordinates}</span>}
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    )}

    <Lightbox />
  </section>

  <script>
    import { initLightbox } from '@scripts/lightbox';
    initLightbox();
  </script>
</SiteLayout>

<style>
  .everyday {
    padding: clamp(2rem, 5vw, 3.5rem) var(--container-padding) 0;
  }

  .everyday__empty {
    color: var(--color-text-muted);
  }

  /* Masonry: columns of frames at their full proportions, no crop. The order runs down each
     column, newest first; the lightbox follows the frame numbers. */
  .everyday {
    overflow-x: clip;
  }

  /* Masonry: columns of frames at their full proportions, no crop. The order runs down each
     column, newest first; the lightbox follows the frame numbers. */
  .everyday__wall {
    --gap: 0.5rem;
    --tab-h: 2.6rem;
    columns: 2;
    column-gap: var(--gap);
  }

  @media (min-width: 768px) {
    .everyday__wall { --gap: 0.75rem; columns: 3; }
  }

  @media (min-width: 1400px) {
    .everyday__wall { columns: 4; }
  }

  .everyday__wall li {
    break-inside: avoid;
    margin-bottom: var(--gap);
  }

  .everyday__frame {
    position: relative;
    display: block;
  }

  /* The photographs as shot: no dimming, no text on the photograph. */
  .everyday__frame :global(img) {
    width: 100%;
    height: auto;
  }

  /* The tab: the date and the coordinates on a small piece of paper that touches the photograph's
     short edge and never covers it. Below 900px every tab sits under its frame (design language 2.8). */
  .everyday__tab {
    display: table;
    padding: 0.3rem 0.4rem;
    background: var(--color-surface);
    color: var(--color-text-muted);
    line-height: 1.35;
    white-space: nowrap;
  }

  .everyday__tab span {
    display: block;
  }

  /* From 900px a landscape frame's short edge is its right side: the tab stands there, top to
     bottom, in a column gap wide enough to hold it. */
  @media (min-width: 900px) {
    .everyday__wall {
      --tab-w: 2.6rem;
      column-gap: calc(var(--tab-w) + var(--gap));
    }

    .everyday__item--landscape .everyday__tab {
      position: absolute;
      top: 0;
      left: 100%;
      writing-mode: vertical-rl;
    }
  }
</style>
