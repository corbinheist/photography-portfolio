---
import SiteLayout from '@layouts/SiteLayout.astro';
import Photo from '@components/photo/Photo.astro';
import Lightbox from '@components/story/Lightbox.astro';
import { formatEverydayDate, loadEveryday } from '@scripts/utils/everyday';
import { formatCoordinates } from '@scripts/utils/story-manifest';

// The Everyday page: the Apple Photos album EDC, newest first. `pnpm everyday sync` writes the
// manifest (src/data/everyday.yaml). Justified rows, as on the Gallery; a click opens the lightbox
// (the photograph alone). Each frame's label (the date, then the coordinates where the frame has them)
// sits on its long edge: under a landscape frame; from 900px, top to bottom on the right of a portrait
// frame. Below 900px every label sits under its frame (design language 2.8). Where the full label does
// not fit, it shortens first: the date as 2026-10-03, then the coordinates as decimals (the stored
// 2-decimal precision). Only the shortest label breaks, at the separator. It is never cut.
const frames = loadEveryday().map((photo, index) => ({
  photo,
  number: index + 1,
  ratio: photo.width / photo.height,
  date: formatEverydayDate(photo.date),
  coordinates: photo.coordinates ? formatCoordinates(photo.coordinates) : undefined,
  decimal: photo.coordinates
    ? [photo.coordinates.latitude, photo.coordinates.longitude].map((value) => value.toFixed(2).replace('-', '−')).join(', ')
    : undefined,
}));
---

<SiteLayout title="Everyday · Heist Studio" description="Everyday photographs, newest first, from the iPhone and the Ricoh GR IIIx.">
  <section class="everyday" data-lightbox-scope>
    <h1 class="visually-hidden">Everyday</h1>

    {frames.length === 0 ? (
      <p class="everyday__empty">No photographs yet.</p>
    ) : (
      <ul class="everyday__wall">
        {frames.map(({ photo, number, ratio, date, coordinates, decimal }) => (
          <li class={ratio >= 1 ? 'everyday__item--landscape' : 'everyday__item--portrait'} style={`--ratio: ${ratio}`}>
            <figure class="everyday__frame" data-frame={number}>
              <Photo url={photo.url} width={photo.width} height={photo.height} lqip={photo.lqip} alt={photo.alt} sizes="(max-width: 767px) 50vw, (max-width: 1399px) 33vw, 25vw" />
              <figcaption class:list={['everyday__label label tabular', { 'everyday__label--coords': coordinates }]}>
                <span class="everyday__full"><span>{date}{coordinates && ' ·'}</span>{coordinates && <> <span>{coordinates}</span></>}</span>
                <span class="everyday__short"><span>{photo.date}{coordinates && ' ·'}</span>{coordinates && <> <span>{coordinates}</span></>}</span>
                {decimal && <span class="everyday__tight"><span>{photo.date} ·</span> <span>{decimal}</span></span>}
              </figcaption>
            </figure>
          </li>
        ))}
      </ul>
    )}

    <Lightbox />
  </section>

  <script>
    import { initLightbox } from '@scripts/lightbox';
    import { matchLastRow } from '@scripts/last-row';
    initLightbox();
    const wall = document.querySelector<HTMLElement>('.everyday__wall');
    if (wall) matchLastRow(wall);
  </script>
</SiteLayout>

<style>
  .everyday {
    padding: clamp(2rem, 5vw, 3.5rem) var(--container-padding) 0;
  }

  .everyday__empty {
    color: var(--color-text-muted);
  }

  /* Justified rows, as on the Gallery (design language 5.6): every frame keeps its full proportions,
     each row has one height, and the order reads left to right, newest first. */
  /* The Gallery's row heights. On a phone a portrait frame is at least 96px wide, wider than the
     decimal coordinates (85px at most). */
  .everyday__wall {
    --row-h: 9rem;
    --gap: 0.5rem;
    display: flex;
    flex-wrap: wrap;
    gap: var(--gap);
  }

  @media (min-width: 768px) {
    .everyday__wall { --row-h: 13rem; --gap: 0.75rem; }
  }

  @media (min-width: 1400px) {
    .everyday__wall { --row-h: 15rem; }
  }

  .everyday__wall li {
    flex-grow: calc(var(--ratio) * 100);
    flex-basis: calc(var(--ratio) * var(--row-h));
    min-width: 0;
  }

  /* Stops the last row from stretching its few frames across the full width. */
  .everyday__wall::after {
    content: '';
    flex-grow: 1000000;
  }

  .everyday__frame {
    position: relative;
    display: block;
    container-type: inline-size;
  }

  /* The photographs as shot: no dimming, no text on the photograph. */
  .everyday__frame :global(img) {
    width: 100%;
    height: auto;
  }

  /* The label: quiet, on the paper, flush with the photograph's edge. Each part keeps together, so a
     label breaks only between the date and the coordinates. */
  /* 11px Light: smaller and lighter than the margin size (13px Regular), by Corbin's direction for
     this label only (design language 5.6b). The colour is the muted marginalia colour. */
  .everyday__label {
    font-size: 0.6875rem;
    font-weight: 300;
    padding-top: 0.25rem;
    color: var(--color-text-muted);
    line-height: 1.25;
  }

  .everyday__full > span,
  .everyday__short > span,
  .everyday__tight > span {
    white-space: nowrap;
  }

  .everyday__short,
  .everyday__tight {
    display: none;
  }

  /* A label under its frame shortens where the frame is narrower than it. Measured at 11px, longest
     case: full 203px, short 165px, the decimal line 85px; a date alone is 100px, or 62px as 2026-10-03. */
  @container (max-width: 12.75rem) {
    .everyday__label--coords .everyday__full { display: none; }
    .everyday__label--coords .everyday__short { display: inline; }
  }

  @container (max-width: 10.375rem) {
    .everyday__label--coords .everyday__short { display: none; }
    .everyday__label--coords .everyday__tight { display: inline; }
  }

  @container (max-width: 6.375rem) {
    .everyday__label:not(.everyday__label--coords) .everyday__full { display: none; }
    .everyday__label:not(.everyday__label--coords) .everyday__short { display: inline; }
  }

  /* From 900px a portrait frame's long edge is its right side: the label runs top to bottom in the
     gap beside it. Its length is the frame's height, at least the row height (208px), which holds the
     full label (203px). */
  @media (min-width: 900px) {
    .everyday__wall {
      column-gap: calc(var(--gap) + 1.5rem);
    }

    .everyday__item--portrait .everyday__label {
      position: absolute;
      top: 0;
      left: 100%;
      max-height: 100%;
      padding: 0 0 0 0.375rem;
      writing-mode: vertical-lr;
    }

    .everyday__item--portrait .everyday__label .everyday__full { display: inline; }
    .everyday__item--portrait .everyday__label .everyday__short,
    .everyday__item--portrait .everyday__label .everyday__tight { display: none; }
  }
</style>
