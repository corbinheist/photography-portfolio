---
import SEO from '@components/global/SEO.astro';
import SiteNav from '@components/global/SiteNav.astro';
import Footer from '@components/global/Footer.astro';
import '@styles/fonts.css';
import '@styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  location?: string;
}

const { title, description, image, type, noindex, location } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,500;1,300&family=Vollkorn:ital,wght@0,400;0,500;1,400&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />
    <SEO title={title} description={description} image={image} type={type} noindex={noindex} location={location} />
    <script is:inline defer src="https://analytics.heist.studio/script.js" data-website-id="c305a664-d222-41eb-937a-8309bf7208f0" data-domains="heist.studio"></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteNav />
    <div class="site-content">
      <main id="main" class="site-main">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<style is:global>
  /* Phone and tablet: a 56px top bar. Desktop: a left rail and no top bar. */
  :root {
    --header-h: 56px;
    --rail-w: 15rem;
    --rail-offset: 0px;
  }

  @media (min-width: 1024px) {
    :root {
      --header-h: 0px;
      --rail-offset: var(--rail-w);
    }

    .site-content {
      margin-left: var(--rail-w);
    }
  }

  /* Cross-document view transitions: the index cover grows into the story hero where the browser supports it. */
  @view-transition {
    navigation: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    @view-transition {
      navigation: none;
    }
  }

  html {
    scroll-padding-top: calc(var(--header-h) + 60px);
  }

  .site-main {
    min-height: 100dvh;
  }

  /* Pages without a hero start below the fixed header. */
  .site-main:not(:has([data-hero])) {
    padding-top: var(--header-h);
  }

  .skip-link {
    position: fixed;
    top: 8px;
    left: 8px;
    z-index: 100;
    padding: 0.6em 1em;
    background: var(--fx-paper);
    color: var(--fx-black);
    font-family: var(--font-mono);
    font-size: 12px;
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }

  .mono-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .tabular {
    font-variant-numeric: tabular-nums;
  }
</style>
