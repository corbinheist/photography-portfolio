---
import SEO from '@components/global/SEO.astro';
import SiteNav from '@components/global/SiteNav.astro';
import Footer from '@components/global/Footer.astro';
import '@styles/fonts.css';
import '@styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  location?: string;
  /** The desktop navigation before the visitor chooses: the rail, or the top bar. Stories start with the bar, so the photographs have the full width. */
  navDefault?: 'rail' | 'bar';
}

const { title, description, image, type, noindex, location, navDefault = 'rail' } = Astro.props;
---

<!doctype html>
<html lang="en" data-nav={navDefault}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:ital,wght@0,300;0,400;0,500;1,300&family=Vollkorn:ital,wght@0,400;0,500;1,400&display=swap"
      rel="stylesheet"
    />
    <!-- Apply the visitor's navigation choice (rail or bar) and theme choice (paper or ink) before the first paint. -->
    <script is:inline>
      try { var nav = localStorage.getItem('nav'); if (nav === 'bar' || nav === 'rail') document.documentElement.dataset.nav = nav; } catch (e) {}
      try { if (localStorage.getItem('theme') === 'ink') document.documentElement.dataset.theme = 'ink'; } catch (e) {}
    </script>
    <slot name="head" />
    <SEO title={title} description={description} image={image} type={type} noindex={noindex} location={location} />
    <script is:inline defer src="https://analytics.heist.studio/script.js" data-website-id="c305a664-d222-41eb-937a-8309bf7208f0" data-domains="heist.studio"></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteNav />
    <div class="site-content">
      <main id="main" class="site-main">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>

<style is:global>
  /* The layout variables (--rail-offset, --header-h) live in SiteNav. The content is padded clear of
     the rail; full-bleed photographs extend under the rail with .bleed. */
  .site-content {
    padding-left: var(--rail-offset);
  }

  .bleed {
    margin-left: calc(-1 * var(--rail-offset));
    width: calc(100% + var(--rail-offset));
  }

  /* Cross-document view transitions: the index cover grows into the story hero where the browser supports it. */
  @view-transition {
    navigation: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    @view-transition {
      navigation: none;
    }
  }

  html {
    scroll-padding-top: calc(var(--header-h) + 60px);
  }

  .site-main {
    min-height: 100dvh;
  }

  /* Pages without a hero start below the fixed header. */
  .site-main:not(:has([data-hero])) {
    padding-top: var(--header-h);
  }

  .skip-link {
    position: fixed;
    top: 8px;
    left: 8px;
    z-index: 100;
    padding: 0.6em 1em;
    background: var(--fx-paper);
    color: var(--fx-black);
    font-variant-numeric: tabular-nums;
    font-size: var(--type-margin);
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }

  /* Hidden on screen, read by screen readers. */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .label {
    font-variant-numeric: tabular-nums;
    font-size: var(--type-margin);
    color: var(--color-text-faint);
  }

  .tabular {
    font-variant-numeric: tabular-nums;
  }
</style>
