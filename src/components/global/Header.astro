---
import { getEntry } from 'astro:content';

const settings = await getEntry('settings', 'settings');
const path = Astro.url.pathname;
const journal = settings?.data.substackUrl ?? 'https://corbinheist.substack.com';
const links = [
  { num: '01', href: '/#work', label: 'Work', current: path === '/' || path.startsWith('/work/') },
  { num: '02', href: '/about/', label: 'About', current: path.startsWith('/about') },
  { num: '03', href: journal, label: 'Journal', external: true },
];
---

<header class="site-header">
  <a href="/" class="wordmark" aria-label="Heist Studio, home">
    <span>HEIST</span>
    <span class="wordmark__accent">STUDIO</span>
  </a>
  <nav aria-label="Site">
    <ul class="site-nav">
      {links.map((link) => (
        <li>
          <a href={link.href} aria-current={link.current ? 'page' : undefined} rel={link.external ? 'noopener' : undefined}>
            <span class="site-nav__num">{link.num}</span>{link.label}{link.external && <span aria-hidden="true"> ↗</span>}
          </a>
        </li>
      ))}
      <li class="site-nav__contact"><a href="/about/#contact">Contact</a></li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    padding-inline: var(--container-padding);
    background-color: rgb(16 15 15 / 0.92);
    border-bottom: 1px solid var(--color-border-subtle);
    backdrop-filter: blur(10px);
  }

  /* Over a hero photograph the header starts clear and turns solid as the page scrolls. */
  :global(html:has([data-hero])) .site-header {
    animation: header-solid linear both;
    animation-timeline: scroll(root);
    animation-range: 0 50svh;
  }

  @keyframes header-solid {
    from { background-color: rgb(16 15 15 / 0); border-bottom-color: transparent; backdrop-filter: blur(0); }
    to { background-color: rgb(16 15 15 / 0.92); border-bottom-color: var(--color-border-subtle); backdrop-filter: blur(10px); }
  }

  .wordmark {
    display: flex;
    flex-direction: column;
    font-family: var(--font-heading);
    font-size: 18px;
    letter-spacing: 0.08em;
    line-height: 1;
    color: var(--fx-paper);
  }

  .wordmark__accent {
    color: var(--hs-moss);
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2.5vw, 2.25rem);
  }

  .site-nav a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5em;
    min-height: 44px;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(255 252 240 / 0.78);
    border-bottom: 1px solid transparent;
    transition: color 160ms ease, border-color 160ms ease;
  }

  .site-nav__num {
    color: rgb(255 252 240 / 0.62);
  }

  .site-nav a:hover,
  .site-nav a[aria-current='page'] {
    color: var(--fx-paper);
  }

  .site-nav a[aria-current='page'] {
    border-bottom-color: var(--hs-moss);
  }

  .site-nav__contact a {
    padding-inline: 0.9em;
    border: 1px solid rgb(255 252 240 / 0.35);
  }

  .site-nav__contact a:hover {
    border-color: var(--hs-moss);
  }

  @media (max-width: 767px) {
    .site-nav__num,
    .site-nav__contact {
      display: none;
    }

    .wordmark {
      font-size: 15px;
    }

    .site-nav a {
      font-size: 11px;
      letter-spacing: 0.12em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html:has([data-hero])) .site-header {
      animation: none;
    }
  }
</style>
