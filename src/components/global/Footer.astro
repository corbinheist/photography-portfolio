---
import { getEntry } from 'astro:content';

const settings = await getEntry('settings', 'settings');
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <a href="mailto:corbin@heist.studio">corbin@heist.studio</a>
  <ul class="site-footer__links">
    {settings?.data.socialLinks.map((link) => (
      <li><a href={link.url} rel="noopener">{link.label}</a></li>
    ))}
  </ul>
  <p class="site-footer__meta">&copy; {year} Corbin Heist &middot; Self-hosted analytics &middot; No cookies</p>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm) var(--space-lg);
    margin-top: var(--space-3xl);
    padding: var(--space-lg) var(--container-padding);
    border-top: 1px solid var(--color-border-subtle);
    font-variant-numeric: tabular-nums;
    font-size: var(--type-margin);
    color: var(--color-text-muted);
  }

  .site-footer a:hover {
    color: var(--color-text);
  }

  .site-footer__links {
    display: flex;
    gap: var(--space-md);
  }

  .site-footer__meta {
    width: 100%;
    color: var(--color-text-faint);
  }
</style>
