---
/**
 * Responsive photo component with AVIF/WebP srcset and LQIP blur placeholder.
 *
 * The `url` prop is the base CDN URL for the photo (without extension/width).
 * Generates srcset for standard widths: 640, 750, 1080, 1600, 2400 (capped at native width)
 */
import { buildPhotoUrl, buildWidthList } from '../../scripts/utils/photo-widths';

interface Props {
  url: string;
  width: number;
  height: number;
  lqip: string;
  alt: string;
  sizes?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
  lightboxIndex?: number;
}

const {
  url,
  width,
  height,
  lqip,
  alt,
  sizes = '(max-width: 640px) 100vw, (max-width: 1080px) 80vw, 60vw',
  loading = 'lazy',
  fetchpriority = 'auto',
  class: className,
  lightboxIndex,
} = Astro.props;

const slug = url.split('/').pop() || '';
const widths = buildWidthList(width);

function buildSrcset(format: 'avif' | 'webp'): string {
  return widths
    .map((w) => `${url}/${slug}-${w}.${format} ${w}w`)
    .join(', ');
}

const avifSrcset = buildSrcset('avif');
const webpSrcset = buildSrcset('webp');
const fallbackSrc = buildPhotoUrl(url, width, 1080);

// The placeholder while the photograph loads: the tiny LQIP drawn through an SVG Gaussian blur,
// so it is a soft image at any size (a plain upscale of a 20px image shows blocks). It is inline,
// so it appears at once even on a slow connection.
const blur = Math.round(Math.max(width, height) / 30);
const placeholderSvg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ${width} ${height}" preserveAspectRatio="none"><filter id="b" color-interpolation-filters="sRGB"><feGaussianBlur stdDeviation="${blur}"/><feComponentTransfer><feFuncA type="discrete" tableValues="1 1"/></feComponentTransfer></filter><image width="100%" height="100%" preserveAspectRatio="none" href="${lqip}" filter="url(#b)"/></svg>`;
const placeholder = `url('data:image/svg+xml;charset=utf-8,${encodeURIComponent(placeholderSvg)}')`;
---

<div class:list={['photo-wrap', className]} {...(lightboxIndex !== undefined ? { 'data-lightbox-index': lightboxIndex } : {})}>
  <picture>
    <source type="image/avif" srcset={avifSrcset} sizes={sizes} />
    <source type="image/webp" srcset={webpSrcset} sizes={sizes} />
    <img
      src={fallbackSrc}
      alt={alt}
      width={width}
      height={height}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding="async"
      style={`--placeholder: ${placeholder}`}
      class="photo-img"
      onload="this.dataset.loaded=''"
    />
  </picture>
</div>

<style>
  .photo-wrap {
    overflow: hidden;
    line-height: 0;
  }

  .photo-img {
    width: 100%;
    object-fit: cover;
    background: var(--placeholder) center / cover no-repeat;
  }

  /* Loaded: drop the placeholder. */
  .photo-img[data-loaded] {
    background: none;
  }
</style>
