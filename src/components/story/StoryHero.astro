---
import Photo from '@components/photo/Photo.astro';
import type { StoryPhoto } from '@scripts/utils/story-manifest';

interface Props {
  photo: StoryPhoto;
  title: string;
  /** Optional: the homepage hero shows only the title and the call to action. */
  summary?: string;
  /** The story number ("№ 02"), the page's seal. The homepage passes its own line. */
  overline?: string;
  /** Coordinates and elevation, set vertically on the plate edge from 900px. */
  coords?: string;
  /** At most two short marginal lines in the text field: the place, then the month and year. */
  margin?: string[];
  cta?: { href: string; label: string; ariaLabel?: string };
  /** Shared with the index thumbnail so the cover grows into the hero on navigation. */
  transitionName?: string;
  headingLevel?: 'h1' | 'h2';
  /** The cover's frame number in a story; the lightbox opens it in sequence. */
  frame?: number;
  /** Edge to edge across the content area, filling the first screen (the homepage). */
  bleed?: boolean;
}

const { photo, title, summary, overline, coords, margin = [], cta, transitionName, headingLevel = 'h1', frame, bleed = false } = Astro.props;
const Heading = headingLevel;
// The story number leads the overline ("№ 02 · place · date"). It is the page's seal.
const numbered = overline?.match(/^№\s*(\d+)(.*)$/s);
---

<section class:list={['hero', { 'hero--bleed': bleed }]} data-hero>
  <div class="hero__media" data-frame={frame} style={`--ratio: ${photo.width / photo.height}${transitionName ? `; view-transition-name: ${transitionName}` : ''}`}>
    <Photo url={photo.url} width={photo.width} height={photo.height} lqip={photo.lqip} alt={photo.alt} sizes="(max-width: 899px) 100vw, 90vw" loading="eager" fetchpriority="high" />
    {coords && <p class="hero__coords tabular">{coords}</p>}
  </div>

  <div class="hero__body">
    {overline && <p class="hero__overline">{numbered ? <><span class="seal">№ {numbered[1]}</span>{numbered[2]}</> : overline}</p>}
    <Heading class="hero__title">{title}</Heading>
    {summary && <p class="hero__summary">{summary}</p>}

    {margin.length > 0 && (
      <p class="hero__margin">{margin.map((line) => <span>{line}</span>)}</p>
    )}

    {cta && <a class="hero__cta" href={cta.href} aria-label={cta.ariaLabel}>{cta.label} <span aria-hidden="true">→</span></a>}
  </div>
</section>

<style>
  /* One plate on paper, as large as the first screen allows, never cropped. The text never sits on
     the photograph: it follows the plate. From 900px the plate fills the first screen, set to the
     right with the coordinates down its edge, and the text starts under it on the left. */
  .hero {
    padding: calc(var(--header-h) + var(--space-lg)) var(--container-padding) var(--space-2xl);
    background: var(--color-bg);
  }

  .hero__media :global(.photo-wrap),
  .hero__media :global(img) {
    width: 100%;
  }

  .hero__overline,
  .hero__cta {
    font-variant-numeric: tabular-nums;
  }

  .hero__overline {
    font-size: var(--type-margin);
    color: var(--color-text-muted);
  }

  .hero__title {
    margin-top: 0.35em;
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: var(--type-title);
    line-height: 0.98;
    letter-spacing: -0.02em;
    color: var(--color-text);
    max-width: 13ch;
    text-wrap: balance;
  }

  .hero__summary {
    margin-top: var(--space-md);
    max-width: 40ch;
    text-wrap: pretty;
    font-size: var(--type-body);
    font-weight: 300;
    line-height: 1.5;
    color: var(--color-text);
  }

  /* Marginalia: small, muted, at most three lines on the first screen. */
  .hero__margin,
  .hero__coords {
    font-size: var(--type-margin);
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .hero__margin {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-lg);
  }

  .hero__coords {
    margin-top: var(--space-sm);
  }

  /* A text link, not a button. */
  .hero__cta {
    display: inline-block;
    margin-top: var(--space-lg);
    font-size: var(--type-margin);
    color: var(--color-text);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.3em;
    transition: border-color 160ms ease, color 160ms ease;
  }

  .hero__cta:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .hero__body {
    margin-top: var(--space-lg);
  }

  @media (min-width: 900px) {
    .hero {
      --hero-h: calc(100svh - var(--header-h) - 1.5rem);
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--space-md);
      row-gap: var(--space-xl);
      align-items: start;
      max-width: var(--container-max);
      margin-inline: auto;
      padding-top: calc(var(--header-h) + 0.75rem);
    }

    .hero__media {
      grid-column: 1 / -1;
      grid-row: 1;
      display: flex;
      justify-content: flex-end;
      align-items: flex-start;
      gap: var(--space-sm);
    }

    /* The plate takes the first screen's height at its own proportions. A frame too wide for the row
       takes the row's width instead, so nothing is cropped or letterboxed. --ratio comes from the
       photograph's dimensions. */
    .hero__media :global(.photo-wrap) {
      flex: none;
      width: min(100% - 2.5rem, var(--hero-h) * var(--ratio));
    }

    .hero__media :global(img) {
      width: 100%;
      height: auto;
    }

    .hero__coords {
      flex: none;
      margin-top: 0;
      writing-mode: vertical-rl;
    }

    /* Under the plate, on the left: the number, the title, the summary, and the marginalia. */
    .hero__body {
      grid-column: 1 / 7;
      grid-row: 2;
      margin-top: 0;
    }
  }
  /* The homepage: the photograph runs edge to edge across the content area and fills the first
     screen, cropped to fit. The text follows on paper below it, never on the photograph. */
  .hero--bleed {
    padding-inline: 0;
    padding-top: var(--header-h);
  }

  .hero--bleed .hero__media :global(img) {
    width: 100%;
    height: calc(100svh - var(--header-h));
    object-fit: cover;
  }

  .hero--bleed .hero__coords,
  .hero--bleed .hero__body {
    padding-inline: var(--container-padding);
  }

  @media (min-width: 900px) {
    .hero.hero--bleed {
      display: block;
      max-width: none;
      padding-top: var(--header-h);
    }

    /* The photograph runs off the left edge; a thin strip of paper on the right carries the
       coordinates, top to bottom, so no text sits on the photograph. */
    .hero--bleed .hero__media {
      display: flex;
      align-items: flex-start;
      gap: 0;
    }

    .hero--bleed .hero__media :global(.photo-wrap) {
      flex: 1 1 auto;
      width: auto;
      min-width: 0;
    }

    .hero--bleed .hero__coords {
      flex: none;
      padding: 0 0.75rem;
    }

    .hero--bleed .hero__media :global(img) {
      height: calc(100svh - var(--header-h));
    }

    .hero--bleed .hero__body {
      max-width: var(--container-max);
      margin-top: var(--space-xl);
    }
  }
</style>
