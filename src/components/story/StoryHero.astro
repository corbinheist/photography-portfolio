---
import Photo from '@components/photo/Photo.astro';
import type { StoryPhoto } from '@scripts/utils/story-manifest';

interface Fact {
  label: string;
  value: string;
  /** A measured value (coordinates, counts) renders in the accent colour. */
  measured?: boolean;
}

interface Props {
  photo: StoryPhoto;
  title: string;
  /** Optional: the homepage hero shows only the title and the call to action. */
  summary?: string;
  overline: string;
  facts?: Fact[];
  cta?: { href: string; label: string; ariaLabel?: string };
  /** Shared with the index thumbnail so the cover grows into the hero on navigation. */
  transitionName?: string;
  headingLevel?: 'h1' | 'h2';
}

const { photo, title, summary, overline, facts = [], cta, transitionName, headingLevel = 'h1' } = Astro.props;
const Heading = headingLevel;
---

<section class="hero" data-hero>
  <div class="hero__media" style={transitionName ? `view-transition-name: ${transitionName}` : undefined}>
    <Photo url={photo.url} width={photo.width} height={photo.height} lqip={photo.lqip} alt={photo.alt} sizes="(max-width: 899px) 100vw, 66vw" loading="eager" fetchpriority="high" />
  </div>

  <div class="hero__body">
    <p class="hero__overline">{overline.split('№').map((part, i) => (i === 0 ? part : <><span class="numero">№</span>{part}</>))}</p>
    <Heading class="hero__title">{title}</Heading>
    {summary && <p class="hero__summary">{summary}</p>}

    {facts.length > 0 && (
      <dl class="hero__facts">
        {facts.map((fact) => (
          <div>
            <dt>{fact.label}</dt>
            <dd class:list={['tabular', { 'is-measured': fact.measured }]}>{fact.value}</dd>
          </div>
        ))}
      </dl>
    )}

    {cta && <a class="hero__cta" href={cta.href} aria-label={cta.ariaLabel}>{cta.label} <span aria-hidden="true">→</span></a>}
  </div>
</section>

<style>
  /* One plate on paper. The text never sits on the photograph: on a phone it follows the plate;
     from 900px the plate stands off-centre on the grid and the text holds the empty field beside it. */
  .hero {
    padding: calc(var(--header-h) + var(--space-lg)) var(--container-padding) var(--space-2xl);
    background: var(--color-bg);
  }

  .hero__media :global(.photo-wrap),
  .hero__media :global(img) {
    width: 100%;
  }

  .hero__overline,
  .hero__facts dt,
  .hero__cta {
    font-family: var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hero__overline {
    font-size: 12px;
    color: var(--color-text-muted);
  }

  .hero__title {
    margin-top: 0.35em;
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    line-height: 0.98;
    letter-spacing: -0.02em;
    color: var(--color-text);
    max-width: 13ch;
    text-wrap: balance;
  }

  .hero__summary {
    margin-top: var(--space-md);
    max-width: 40ch;
    text-wrap: pretty;
    font-size: var(--text-lg);
    font-weight: 300;
    line-height: 1.5;
    color: var(--color-text);
  }

  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) clamp(1.25rem, 2vw, 2rem);
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }

  .hero__facts dt {
    font-size: 10px;
    color: var(--color-text-muted);
  }

  .hero__facts dd {
    margin-top: 0.4em;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.06em;
    color: var(--color-text);
  }

  .hero__facts dd.is-measured {
    color: var(--color-accent);
  }

  /* A text link, not a button. */
  .hero__cta {
    display: inline-block;
    margin-top: var(--space-lg);
    font-size: 12px;
    color: var(--color-text);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.3em;
    transition: border-color 160ms ease, color 160ms ease;
  }

  .hero__cta:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .hero__body {
    margin-top: var(--space-lg);
  }

  @media (min-width: 900px) {
    .hero {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--space-md);
      align-items: end;
      max-width: var(--container-max);
      margin-inline: auto;
    }

    /* The plate: columns 5 to 12, at its own proportions, no taller than the screen allows. */
    .hero__media {
      grid-column: 5 / -1;
      grid-row: 1;
    }

    .hero__media :global(img) {
      width: auto;
      max-width: 100%;
      max-height: calc(100svh - var(--header-h) - 2 * var(--space-lg));
      margin-left: auto;
      object-fit: contain;
    }

    /* The empty field: columns 1 to 4, the text set low, level with the foot of the plate. */
    .hero__body {
      grid-column: 1 / 5;
      grid-row: 1;
      margin-top: 0;
    }
  }
</style>
