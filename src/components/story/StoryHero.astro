---
import Photo from '@components/photo/Photo.astro';
import type { StoryPhoto } from '@scripts/utils/story-manifest';

interface Props {
  photo: StoryPhoto;
  title: string;
  /** Optional: the homepage hero shows only the title and the call to action. */
  summary?: string;
  /** The story number ("№ 02"), the page's seal. The homepage passes its own line. */
  overline?: string;
  /** Coordinates and elevation, set vertically on the plate edge from 900px. */
  coords?: string;
  /** At most two short marginal lines in the text field: the place, then the month and year. */
  margin?: string[];
  cta?: { href: string; label: string; ariaLabel?: string };
  /** Shared with the index thumbnail so the cover grows into the hero on navigation. */
  transitionName?: string;
  headingLevel?: 'h1' | 'h2';
}

const { photo, title, summary, overline, coords, margin = [], cta, transitionName, headingLevel = 'h1' } = Astro.props;
const Heading = headingLevel;
// The story number leads the overline ("№ 02 · place · date"). It is the page's seal.
const numbered = overline?.match(/^№\s*(\d+)(.*)$/s);
---

<section class="hero" data-hero>
  <div class="hero__media" style={transitionName ? `view-transition-name: ${transitionName}` : undefined}>
    <Photo url={photo.url} width={photo.width} height={photo.height} lqip={photo.lqip} alt={photo.alt} sizes="(max-width: 899px) 100vw, 66vw" loading="eager" fetchpriority="high" />
    {coords && <p class="hero__coords tabular">{coords}</p>}
  </div>

  <div class="hero__body">
    {overline && <p class="hero__overline">{numbered ? <><span class="seal">№ {numbered[1]}</span>{numbered[2]}</> : overline}</p>}
    <Heading class="hero__title">{title}</Heading>
    {summary && <p class="hero__summary">{summary}</p>}

    {margin.length > 0 && (
      <p class="hero__margin">{margin.map((line) => <span>{line}</span>)}</p>
    )}

    {cta && <a class="hero__cta" href={cta.href} aria-label={cta.ariaLabel}>{cta.label} <span aria-hidden="true">→</span></a>}
  </div>
</section>

<style>
  /* One plate on paper. The text never sits on the photograph: on a phone it follows the plate;
     from 900px the plate stands off-centre on the grid and the text holds the empty field beside it. */
  .hero {
    padding: calc(var(--header-h) + var(--space-lg)) var(--container-padding) var(--space-2xl);
    background: var(--color-bg);
  }

  .hero__media :global(.photo-wrap),
  .hero__media :global(img) {
    width: 100%;
  }

  .hero__overline,
  .hero__cta {
    font-variant-numeric: tabular-nums;
  }

  .hero__overline {
    font-size: var(--type-margin);
    color: var(--color-text-muted);
  }

  .hero__title {
    margin-top: 0.35em;
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: var(--type-title);
    line-height: 0.98;
    letter-spacing: -0.02em;
    color: var(--color-text);
    max-width: 13ch;
    text-wrap: balance;
  }

  .hero__summary {
    margin-top: var(--space-md);
    max-width: 40ch;
    text-wrap: pretty;
    font-size: var(--type-body);
    font-weight: 300;
    line-height: 1.5;
    color: var(--color-text);
  }

  /* Marginalia: small, muted, at most three lines on the first screen. */
  .hero__margin,
  .hero__coords {
    font-size: var(--type-margin);
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .hero__margin {
    display: flex;
    flex-direction: column;
    margin-top: var(--space-lg);
  }

  .hero__coords {
    margin-top: var(--space-sm);
  }

  /* A text link, not a button. */
  .hero__cta {
    display: inline-block;
    margin-top: var(--space-lg);
    font-size: var(--type-margin);
    color: var(--color-text);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 0.3em;
    transition: border-color 160ms ease, color 160ms ease;
  }

  .hero__cta:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
  }

  .hero__body {
    margin-top: var(--space-lg);
  }

  @media (min-width: 900px) {
    .hero {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--space-md);
      align-items: end;
      max-width: var(--container-max);
      margin-inline: auto;
    }

    /* The plate: columns 5 to 12, at its own proportions, no taller than the screen allows. The
       coordinates run top to bottom up its left edge. */
    .hero__media {
      grid-column: 5 / -1;
      grid-row: 1;
      display: flex;
      flex-direction: row-reverse;
      align-items: flex-end;
      gap: var(--space-sm);
    }

    .hero__media :global(.photo-wrap) {
      flex: 0 1 auto;
      min-width: 0;
    }

    .hero__coords {
      flex: none;
      margin-top: 0;
      writing-mode: vertical-rl;
    }

    .hero__media :global(img) {
      width: auto;
      max-width: 100%;
      max-height: calc(100svh - var(--header-h) - 2 * var(--space-lg));
      margin-left: auto;
      object-fit: contain;
    }

    /* The empty field: columns 1 to 4, the text set low, level with the foot of the plate. */
    .hero__body {
      grid-column: 1 / 5;
      grid-row: 1;
      margin-top: 0;
    }
  }
</style>
